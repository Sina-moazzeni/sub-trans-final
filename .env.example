# Gemini API key (optional on server if users provide their own key in the UI)
GEMINI_API_KEY=

# Set to "false" to disable the server-side Gemini key and require BYOK
ALLOW_SERVER_KEY=true

# Optional comma-separated list of allowed CORS origins
ALLOWED_ORIGIN=

# Optional custom Gemini API base URL
GEMINI_BASE_URL=

# Per-IP requests/minute rate limit for AI endpoints (0 disables)
AI_RATE_LIMIT=30

# Server port (defaults to 3000)
PORT=3000
